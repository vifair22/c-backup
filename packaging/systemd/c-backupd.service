[Unit]
Description=c-backup daemon
Documentation=https://git.airies.net/vifair22/c-backup
After=network-online.target
Wants=network-online.target

[Service]
# notify, not simple: the daemon sends READY=1 once its unix socket and TCP
# listener are bound, so `systemctl start` (and anything ordered After= this
# unit) returns only when a client can connect. Under simple the unit went
# active at fork, and `systemctl enable --now c-backupd; c-backup health`
# found no socket yet. Startup applies schema migrations before it is ready,
# which on a large state database outlasts the 90 s default.
Type=notify
NotifyAccess=main
TimeoutStartSec=10min
ExecStart=/usr/local/bin/c-backupd
Environment=C_BACKUP_CONFIG_PATH=/etc/c-backupd/config.yaml

# Runs as root for now: reading arbitrary source paths and restoring metadata
# both need it. Capability-based hardening is a later revisit.
User=root

# The socket directory has to exist before the daemon binds; systemd creates
# and cleans it up so a stale socket never survives a crash.
RuntimeDirectory=c-backupd
RuntimeDirectoryMode=0755
StateDirectory=c-backupd
StateDirectoryMode=0700

Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
